package main;

import (
	"fmt";
	m "mymodule";
)

const (
	pi float = 3.14;
	e float = 2.71;
)

var a, b int = 1, 2;

func add(a, b int) int {
	return a + b;
}

func main() {
	var sum int = add(a, b);

	if sum > 0 {
		fmt.Println(sum);
	} else {
		fmt.Println(0);
	}

	for i := 0; i < 10; i = i + 1 {
		if i == 5 {
			break;
		}
		continue;
	}

	m.DoSomething(a, b, sum);
}
